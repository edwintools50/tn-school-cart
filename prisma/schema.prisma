// TN School Cart data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PRINCIPAL
  SUPPLIER
  WORKER
  TEACHER
  COACHING_CENTRE
  ADMIN
}

enum TeachingSubject {
  TAMIL
  ENGLISH
  MATHS
  SCIENCE
  SOCIAL_SCIENCE
  COMPUTER_SCIENCE
  PHYSICAL_EDUCATION
  ARTS_CRAFT
  MUSIC
  PRIMARY_TEACHER
  SPECIAL_EDUCATOR
  LIBRARIAN
  // PG Teacher (postgraduate subject) specializations
  PG_TAMIL
  PG_SPECIAL_TAMIL
  PG_ENGLISH
  PG_HINDI
  PG_ARABIC
  PG_FRENCH
  PG_MATHS
  PG_PHYSICS
  PG_CHEMISTRY
  PG_BIOLOGY
  PG_BOTANY
  PG_ZOOLOGY
  PG_BIO_CHEMISTRY
  PG_MICRO_BIOLOGY
  PG_ACCOUNTANCY
  PG_COMMERCE
  PG_HISTORY
  PG_ECONOMICS
  PG_BUSINESS_MATHS
  PG_STATISTICS
  PG_COMPUTER_SCIENCE
  PG_POLITICAL_SCIENCE
  PG_NURSING
  PG_PSYCHOLOGY
  PG_SOCIOLOGY
  PG_VOCATIONAL_OFFICE_MANAGEMENT
  PG_VOCATIONAL_GENERAL_NURSING
  PG_VOCATIONAL_NUTRITION_DIETETICS
  PG_VOCATIONAL_BASIC_ENGINEERING
  PG_VOCATIONAL_TEXTILE_TECHNOLOGY
  // Competitive-exam coaching experts
  NEET_EXPERT_BIOLOGY
  NEET_EXPERT_BOTANY
  NEET_EXPERT_PHYSICS
  NEET_EXPERT_CHEMISTRY
  NEET_EXPERT_ZOOLOGY
  JEE_MAIN_EXPERT_PHYSICS
  JEE_MAIN_EXPERT_CHEMISTRY
  JEE_MAIN_EXPERT_MATHS
  JEE_ADVANCED_EXPERT_PHYSICS
  JEE_ADVANCED_EXPERT_CHEMISTRY
  JEE_ADVANCED_EXPERT_MATHS
  // TET (Teacher Eligibility Test) coaching experts
  TET_PAPER_I_EXPERT_TAMIL
  TET_PAPER_I_EXPERT_ENGLISH
  TET_PAPER_I_EXPERT_MATHS
  TET_PAPER_I_EXPERT_SCIENCE
  TET_PAPER_I_EXPERT_SOCIAL
  TET_PAPER_II_EXPERT_TAMIL
  TET_PAPER_II_EXPERT_ENGLISH
  TET_PAPER_II_EXPERT_MATHS
  TET_PAPER_II_EXPERT_SCIENCE
  TET_PAPER_II_EXPERT_SOCIAL
  OTHER
}

enum CoachingMode {
  OFFLINE
  ONLINE
  HYBRID
}

enum CompetitiveExam {
  NEET
  JEE_MAIN
  JEE_ADVANCED
  CUET
  CLAT
  TET
  BANK_SSC_RAILWAYS
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum JobVacancyStatus {
  OPEN
  FILLED
  CLOSED
}

enum JobApplicationStatus {
  PENDING
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum QuickSignupStatus {
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ProductCategory {
  STATIONERY
  FURNITURE
  EDUCATIONAL_CONTENT
  NOTEBOOKS
  HEALTH_HYGIENE
  SPORTS
  IT_ELECTRONICS
  EXAM_PRINT_STATIONERY
  UNIFORM_MERCHANDISE
  OTHER
}

enum GigCategory {
  PLUMBING
  ELECTRICAL
  TOILET_CLEANING
  GENERAL_CLEANING
  CARPENTRY
  PAINTING
  PEST_CONTROL
  GARDENING
  IT_SUPPORT
  RO_WATER_SERVICE
  SMART_BOARD_CCTV
  PRINTING_SERVICES
  CATERING
  STUDENT_STAFF_TRANSPORT
  GOODS_TRANSPORT
  OTHER
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  DELISTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum GigRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum GigOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  phone          String
  role           Role
  status         ApprovalStatus @default(PENDING)
  // Principal fields
  schoolName     String?
  udiseNumber    String?
  district       String?
  // Supplier / Worker fields
  businessName   String?
  serviceArea    String?
  rejectionNote  String?
  verificationPhotoUrl String?
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  // Teacher fields (serviceArea above is reused as "preferred district")
  qualification         String?
  subjectSpecialization TeachingSubject?
  experienceYears        Int?
  resumeUrl              String?
  // Coaching Centre fields (businessName = centre name, serviceArea = district,
  // verificationPhotoUrl = centre photo, all reused from the fields above)
  examsOffered   CompetitiveExam[] @default([])
  coachingMode   CoachingMode?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products       Product[]
  cartItems      CartItem[]
  orders         Order[]        @relation("BuyerOrders")
  orderItems     OrderItem[]    @relation("SupplierOrderItems")
  gigServices    GigService[]
  gigRequests    GigRequest[]   @relation("PrincipalGigRequests")
  gigOffers      GigOffer[]     @relation("WorkerGigOffers")
  jobVacancies   JobVacancy[]   @relation("PrincipalJobVacancies")
  jobApplications JobApplication[] @relation("TeacherJobApplications")
}

model Product {
  id          String          @id @default(cuid())
  supplierId  String
  supplier    User            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    ProductCategory
  price       Float
  unit        String          @default("piece")
  stock       Int             @default(0)
  imageUrl    String?
  isDigital   Boolean         @default(false)
  fileUrl     String?
  status      ProductStatus   @default(PENDING)
  rejectionNote String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([category])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([buyerId, productId])
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  totalAmount Float
  shippingSchool String
  shippingUdise String?
  shippingDistrict String
  shippingTaluk String?
  shippingBlock String?
  shippingPinCode String?
  shippingAddress String
  paid        Boolean     @default(false)
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  createdAt   DateTime    @default(now())

  items       OrderItem[]
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  supplierId   String
  supplier     User        @relation("SupplierOrderItems", fields: [supplierId], references: [id])
  titleAtOrder String
  priceAtOrder Float
  quantity     Int
  status       OrderStatus @default(PLACED)
}

model GigService {
  id            String        @id @default(cuid())
  workerId      String
  worker        User          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category      GigCategory
  title         String
  description   String
  priceType     String        @default("QUOTE") // FIXED | HOURLY | QUOTE
  price         Float?
  serviceArea   String
  status        ProductStatus @default(PENDING)
  rejectionNote String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model GigRequest {
  id            String            @id @default(cuid())
  principalId   String
  principal     User              @relation("PrincipalGigRequests", fields: [principalId], references: [id], onDelete: Cascade)
  category      GigCategory
  title         String
  description   String
  schoolName    String
  udiseNumber   String?
  district      String
  taluk         String?
  block         String?
  pinCode       String?
  address       String
  photoUrl      String?
  completionPhotoUrl String?
  preferredDate DateTime?
  budget        Float?
  status        GigRequestStatus  @default(OPEN)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  offers        GigOffer[]
}

model GigOffer {
  id           String         @id @default(cuid())
  gigRequestId String
  gigRequest   GigRequest     @relation(fields: [gigRequestId], references: [id], onDelete: Cascade)
  workerId     String
  worker       User           @relation("WorkerGigOffers", fields: [workerId], references: [id], onDelete: Cascade)
  quotedPrice  Float
  message      String
  status       GigOfferStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  @@unique([gigRequestId, workerId])
}

model JobVacancy {
  id                    String             @id @default(cuid())
  // Despite the field name, the poster is either a PRINCIPAL (school) or a
  // COACHING_CENTRE recruiter — kept as "principal" to avoid a column rename
  // on a live database; branch on `principal.role` when it matters.
  principalId           String
  principal             User               @relation("PrincipalJobVacancies", fields: [principalId], references: [id], onDelete: Cascade)
  subject               TeachingSubject
  title                 String
  description           String
  schoolName            String
  udiseNumber           String?
  district              String
  taluk                 String?
  block                 String?
  pinCode               String?
  address               String
  employmentType        EmploymentType
  qualificationRequired String
  experienceRequired    String
  salaryRange           String?
  // Set only for COACHING_CENTRE-posted vacancies (a specific batch's mode);
  // null for school vacancies, which are implicitly in-person.
  coachingMode          CoachingMode?
  status                JobVacancyStatus   @default(OPEN)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  applications          JobApplication[]
}

model JobApplication {
  id           String               @id @default(cuid())
  jobVacancyId String
  jobVacancy   JobVacancy           @relation(fields: [jobVacancyId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User                 @relation("TeacherJobApplications", fields: [teacherId], references: [id], onDelete: Cascade)
  coverNote    String
  status       JobApplicationStatus @default(PENDING)
  createdAt    DateTime             @default(now())

  @@unique([jobVacancyId, teacherId])
}

// Staging record for the shareable "quick signup" recruitment forms
// (/join/teacher, /join/worker, /join/vendor). Never becomes a real User
// until an admin approves it — see QuickSignupStatus. Only TEACHER, WORKER,
// and SUPPLIER use this flow; Role is reused rather than a separate enum so
// the values stay in lockstep with the main Role type.
model QuickSignup {
  id     String @id @default(cuid())
  role   Role
  name   String
  email  String
  phone  String
  district String

  // Teacher-specific
  qualification          String?
  subjectSpecialization  TeachingSubject?
  experienceYears        Int?

  // Worker/Supplier-specific
  businessName    String?
  gigCategory     GigCategory?
  productCategory ProductCategory?

  // The one "first listing" offering captured on the worker/supplier form —
  // promoted into a real GigService/Product row on admin approval.
  offeringTitle       String?
  offeringDescription String?
  offeringPrice       Float?
  offeringUnit        String?
  offeringStock       Int?

  otpHash      String
  otpExpiresAt DateTime
  otpAttempts  Int      @default(0)
  verifiedAt   DateTime?

  status        QuickSignupStatus @default(PENDING_VERIFICATION)
  rejectionNote String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([email, role])
  @@index([status])
}

model RateLimitAttempt {
  id         String   @id @default(cuid())
  identifier String
  action     String
  createdAt  DateTime @default(now())

  @@index([identifier, action, createdAt])
}
